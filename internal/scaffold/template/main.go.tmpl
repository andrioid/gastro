package main

//go:generate go tool gastro generate

import (
	"fmt"
	"net/http"
	"os"

	gastro "{{ .ProjectName }}/.gastro"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "4242"
	}

	// Pages are GET views. Register commands (POST, PUT, DELETE, ...) and
	// other endpoints next to them as ordinary handlers:
	//
	//	gastro.New(gastro.WithHandler("POST /signup", http.HandlerFunc(signup)))
	//
	// Render components from Go with router.Render(gastro.X, gastro.XProps{...}).
	handler := gastro.New().Handler()

	fmt.Printf("Listening on http://localhost:%s\n", port)
	http.ListenAndServe(":"+port, handler)
}
