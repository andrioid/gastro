---
type Props struct {
    Title string
}

Title := gastro.Props().Title
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="/static/styles.css">
    {{ datastarScript }}
</head>
<body>
    {{/* The live root: the page's stream morphs it after every change. */}}
    <main>{{ liveRoot .Children }}</main>
    {{/* Outside the root, so a morph never restarts the stream. */}}
    {{ liveScript }}
</body>
</html>
