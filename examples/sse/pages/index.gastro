---
import (
    "sse-example/app"

    Layout "components/layout.gastro"
    Counter "components/counter.gastro"
)

// Pages are GET views. The increment command lives in main.go as a
// WithHandler handler (POST /increment) that patches the Counter
// component over SSE. *app.State is registered via gastro.WithDeps in
// main.go and retrieved here through the typed dep API.
state := gastro.From[*app.State](r.Context())

Title := "SSE + Datastar Counter"
Count := int(state.Count.Load())
---
{{ wrap Layout (dict "Title" .Title) }}
    <h1>SSE + Datastar Counter</h1>
    <p>Click the button to increment the counter via a server-sent event.
       <code>pages/index.gastro</code> renders the page; the
       <code>POST /increment</code> handler registered with
       <code>WithHandler</code> patches the counter.</p>

    {{ Counter (dict "Count" .Count) }}
    <button data-on:click="@post('/increment')">Increment</button>

    <h2>Live Clock</h2>
    <p>This clock updates every second via a separate SSE stream.</p>
    <div id="clock" data-init="@get('/api/clock')">--:--:--</div>
{{ end }}
