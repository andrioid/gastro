---
import (
    "time"

    "sse-example/app"

    Layout "components/layout.gastro"
    Counter "components/counter.gastro"
)

// Pages are GET views (queries). The layout makes this a live page: its
// stream re-renders the page after every change and morphs the live root,
// so the page renders current state and never patches anything by hand.
// The POST /increment command only writes and answers 204. *app.State
// comes from gastro.WithDeps.
state := gastro.From[*app.State](r.Context())

Title := "SSE + Datastar Counter"
Count := state.Count()
Clock := time.Now().Format("15:04:05")
---
{{ wrap Layout (dict "Title" .Title) }}
    <h1>SSE + Datastar Counter</h1>
    <p>A live page: the layout's stream re-renders this page after every
       change and Datastar morphs it in place. The <code>POST /increment</code>
       command answers <code>204 No Content</code>; every open tab sees the
       new count.</p>

    {{ Counter (dict "Count" .Count) }}
    <button data-on:click="@post('/increment')">Increment</button>

    <h2>Live Clock</h2>
    <p>The server signals a change every second, so the page re-renders.</p>
    <div id="clock">{{ .Clock }}</div>
{{ end }}
