---
import (
    "sse-example/app"

    Layout "components/layout.gastro"
    Counter "components/counter.gastro"
)

// Pages are GET views (queries). The page opens one long-lived stream
// (GET /stream) that keeps the counter and the clock current; the
// POST /increment command only writes and answers 204. Both handlers are
// registered with WithHandler in main.go. *app.State comes from
// gastro.WithDeps.
state := gastro.From[*app.State](r.Context())

Title := "SSE + Datastar Counter"
Count := state.Count()
---
{{ wrap Layout (dict "Title" .Title) }}
    <div data-init="@get('/stream')">
        <h1>SSE + Datastar Counter</h1>
        <p><code>pages/index.gastro</code> renders the page and opens one
           stream, <code>GET /stream</code>. The <code>POST /increment</code>
           command answers <code>204 No Content</code>; the stream re-renders
           the counter in every open tab.</p>

        {{ Counter (dict "Count" .Count) }}
        <button data-on:click="@post('/increment')">Increment</button>

        <h2>Live Clock</h2>
        <p>The same stream patches the clock every second.</p>
        <div id="clock">--:--:--</div>
    </div>
{{ end }}
