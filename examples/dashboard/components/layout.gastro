---
type Props struct {
    Title string
}

Title := gastro.Props().Title
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="/static/styles.css">
    {{ datastarScript }}
</head>
<body>
    {{ .Children }}
</body>
</html>
